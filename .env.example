# Copy this file to .env and fill in your values.  Never commit .env.
#   cp .env.example .env && nano .env

# From https://app.localstack.cloud -> Settings -> Auth Tokens
LOCALSTACK_AUTH_TOKEN=

# Same region you will use on real AWS later.
AWS_DEFAULT_REGION=ap-south-1
AWS_REGION=ap-south-1

# cdklocal strips all AWS_* variables unless they are listed here;
# without this line it silently deploys to us-east-1.
AWS_ENVAR_ALLOWLIST=AWS_REGION,AWS_DEFAULT_REGION

# Dummy credentials: LocalStack accepts any value.
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test

# Email address used for the SNS alerts subscription (on real AWS you get a confirmation email;
# approval requests arrive here).
ALERT_EMAIL=you@example.com

# Real AWS (Step 8): the named AWS CLI profile the aws-* make targets use (see docs/aws.md).
# The LocalStack keys above are removed for those targets.
AWS_THESIS_PROFILE=thesis
